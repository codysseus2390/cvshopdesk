# Copy to .env.local; use a separate development/staging Supabase project.
SHOPDESK_ENVIRONMENT=development
SUPABASE_PROJECT_ID=replace-with-staging-project-id
VITE_SUPABASE_PROJECT_ID=replace-with-staging-project-id
SUPABASE_URL=https://replace-with-staging-project-id.supabase.co
VITE_SUPABASE_URL=https://replace-with-staging-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key

# Optional server-only keys; never use a VITE_ prefix for these.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Autoflow: server-only. Use the shop subdomain, not the documentation host.
# Credentials come from Autoflow's administrator Integration Setup page.
AUTOFLOW_SUBDOMAIN=cedarvalley
AUTOFLOW_API_KEY=
AUTOFLOW_API_PASSWORD=
# Generated by Autoflow for an individual webhook (separate from API credentials).
AUTOFLOW_WEBHOOK_SECURITY_KEY=
# Enable only after the inbox migration, shop mapping, and deployment are verified.
AUTOFLOW_WEBHOOK_ENABLED=false
AUTOFLOW_SHOP_ID=
AUTOFLOW_SHOPDESK_SHOP_ID=

# Add database test / migration credentials only for verified staging operations.
